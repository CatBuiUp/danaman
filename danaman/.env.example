# Web3Forms — contact form (public key, safe to expose in browser)
# Create a free access key at https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key
CONTACT_EMAIL_FROM=supportteamseekra@gmail.com

# Vercel KV — required on Vercel for persisting heart/like counts (serverless FS is read-only)
# Create a KV store in Vercel dashboard → Storage → Connect to project (auto-injects vars below)
KV_REST_API_URL=
KV_REST_API_TOKEN=